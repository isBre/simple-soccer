[Unit]
Description=Net server for the live opponent picker (port 7304: the opponent net chosen on the dashboard's Live page)
After=network-online.target

[Service]
User=isbre
WorkingDirectory=/home/isbre/simple-soccer
ExecStart=/home/isbre/rl-venv/bin/python /home/isbre/simple-soccer/tools/net_server.py --port 7304 --model data/models/rl_5v5_arena_v4.json --select-file logs/live_opp_net.json
Nice=10
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

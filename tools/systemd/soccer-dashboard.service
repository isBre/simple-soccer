[Unit]
Description=Soccer experiment dashboard (read-only web page on port 8080, local network)
After=network-online.target

[Service]
User=isbre
WorkingDirectory=/home/isbre/simple-soccer
ExecStart=/usr/bin/python3 /home/isbre/simple-soccer/tools/dashboard.py --port 8080
Nice=15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

[Unit]
Description=Soccer RL experiment runner (rl/exp_runner.py)
After=network-online.target

[Service]
User=isbre
WorkingDirectory=/home/isbre/simple-soccer/rl
Environment=GODOT_SILENCE_ROOT_WARNING=1
ExecStart=/home/isbre/rl-venv/bin/python /home/isbre/simple-soccer/rl/exp_runner.py --loop --viewer
Nice=10
Restart=always
RestartSec=30
# a stop (reboot or systemctl stop) interrupts the trainer cleanly so its Godot workers close
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

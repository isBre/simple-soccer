[Unit]
Description=Soccer Lab full screen on the Pi's touch screen (lab/kiosk.py: Chromium kiosk on the Live page)
After=soccer-dashboard.service graphical.target
Wants=soccer-dashboard.service

[Service]
User=isbre
WorkingDirectory=/home/isbre/simple-soccer
ExecStart=/home/isbre/rl-venv/bin/python /home/isbre/simple-soccer/lab/kiosk.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

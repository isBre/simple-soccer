[Unit]
Description=Simple Soccer web app on port 8080 (Game + Lab dashboard, local network)
After=network-online.target

[Service]
User=isbre
WorkingDirectory=/home/isbre/simple-soccer
ExecStart=/home/isbre/rl-venv/bin/python /home/isbre/simple-soccer/web/app.py --port 8080
Nice=15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

+## Is the real kick normal n close enough to the wanted direction d for this shot / pass?
+## Tolerance = angle under which the ball still goes where it is meant to (inside the goal mouth, onto the
+## receiver), relaxed the longer the player has waited so he never dithers around the ball.
+func _aligned(sim: MatchSim, p: SimPlayer, n: Vector2, d: Vector2, bp: Vector2) -> bool:
+    var ang := absf(n.angle_to(d))
+    var tol: float
+    if _kind == "shoot":
+        var ax := sim.attack_dir(p.team)
+        var gx := ax * sim.pitch.half_w
+        var yd := _cross_y(sim, d, gx, ax)
+        var slack := sim.pitch.goal_half - sim.ball.radius - absf(yd) if yd != INF else 0.0
+        tol = atan2(maxf(slack, 8.0), maxf(absf(gx - bp.x), 60.0))
+        tol = clampf(tol, deg_to_rad(2.5), deg_to_rad(9.0))
+    else:
+        tol = clampf(atan2(16.0, maxf(bp.distance_to(_aim), 60.0)), deg_to_rad(3.0), deg_to_rad(10.0))
+    tol *= 1.0 + float(_wait) / 4.0
+    return ang < tol
